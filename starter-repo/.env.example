# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# VPS nhẹ dùng openai_compatible. Thử cục bộ có thể dùng ollama hoặc fake.
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
API_KEY=
LLM_API_BASE=https://api.openai.com/v1
# Thư mục chứa encoder.int8.onnx, decoder.onnx, joiner.int8.onnx và tokens.txt.
ZIPFORMER_MODEL_DIR=
# sherpa hoặc onnx. Backend onnx dùng WAV 16 kHz và requirements-voice.txt.
ZIPFORMER_BACKEND=onnx
# Model hỗ trợ ảnh của nhà cung cấp API. Thử Ollama cục bộ dùng gemma3:4b.
VISION_MODEL=
# Để trống hai mục sau để dùng chung LLM_API_BASE và API_KEY.
VISION_API_BASE=
VISION_API_KEY=
# API VieNeu chính thức.
VIENEU_TTS_BACKEND=api
VIENEU_API_KEY=
VIENEU_MODEL=vieneu-v4
VIENEU_VOICE=Minh Quân Pro
# Tên miền trỏ về VPS cho HTTPS. Docker compose đọc biến này.
DOMAIN=
# Tài khoản truy cập bản demo trên VPS và hash mật khẩu do Caddy tạo.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
# Ngoài Docker có thể đặt đường dẫn riêng cho DB.
CBC_DB_PATH=
# Backend FastAPI cho Railway / frontend Vercel.
APP_USERNAME=demo
APP_PASSWORD=
# Tạo bằng python -c "import secrets; print(secrets.token_urlsafe(32))".
APP_SECRET=
# Tùy chọn để bật đăng nhập Google; Client ID dùng cùng một giá trị trên Vercel.
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000
PORT=8000
